    {
      "name": "动态码 URL（带 lessonId）",
      "raw": "https://www.yuketang.cn/api/v3/lesson/checkin?c=9f2c1a&t=1763900000&s=4b1d&v=2&lessonId=1529274209982060032",
      "expect": {
        "kind": "DYNAMIC_CHECKIN",
        "host": "www.yuketang.cn",
        "lessonId": "1529274209982060032",
        "params": {
          "c": "9f2c1a",
          "t": "1763900000",
          "s": "4b1d",
          "v": "2",
          "lessonId": "1529274209982060032"
        }
      }
    },
    {
      "name": "动态码 纯 query 串",
      "raw": "c=abc123&t=1763900000&s=deadbeef&v=2",
      "expect": {
        "kind": "DYNAMIC_CHECKIN",
        "params": {
          "c": "abc123",
          "t": "1763900000",
          "s": "deadbeef",
          "v": "2"
        }
      }
    },
